# =====================================================================
# Marle Fashion — variables de entorno
# Copia este archivo a .env y completa los valores. NUNCA subas .env.
# =====================================================================

# --- Django ---------------------------------------------------------
# dev | prod  (selecciona config.settings.dev o config.settings.prod)
DJANGO_ENV=dev
# Clave larga y aleatoria. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=true
# Hosts separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Orígenes confiables para CSRF y CORS (separados por coma, con esquema)
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Ruta del admin de Django (no predecible). Sin "/" inicial, con "/" final.
ADMIN_URL_PATH=panel-nataly-cambiar/
# Exigir 2FA TOTP para entrar al admin (true en prod)
ADMIN_REQUIRE_2FA=false

# --- Base de datos / cache -----------------------------------------
POSTGRES_DB=tiendanataly
POSTGRES_USER=tiendanataly
POSTGRES_PASSWORD=cambia-esta-clave-de-db
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# --- Cookies / HTTPS (activar en producción) -----------------------
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# --- Imágenes -------------------------------------------------------
# local | cloudinary  (fase 5 usa cloudinary)
MEDIA_STORAGE=local
CLOUDINARY_URL=

# --- Tienda (valores por defecto; se editan luego en StoreSettings) -
STORE_NAME=Marle Fashion
STORE_WHATSAPP=51900000000

# --- Pagos ----------------------------------------------------------
# manual_yape_plin | culqi
PAYMENTS_PROVIDER=manual_yape_plin
# Solo fase 3. La clave secreta NUNCA llega al frontend.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=
# Base de la API de Culqi (confirmar en https://apidocs.culqi.com/ con tus llaves de sandbox)
CULQI_API_BASE=https://api.culqi.com/v2
# Opcional: si activas "autenticación" al registrar el webhook en el CulqiPanel (Eventos > Webhooks)
CULQI_WEBHOOK_BASIC_USER=
CULQI_WEBHOOK_BASIC_PASSWORD=

# --- Integraciones --------------------------------------------------
# Next.js: revalidación ISR on-demand (mismo valor en backend y frontend)
FRONTEND_URL=http://frontend:3000
REVALIDATE_SECRET=cambia-este-secreto-de-revalidacion
# n8n (fase 3, avisos por WhatsApp)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Frontend (Next.js) ---------------------------------------------
# URL del backend alcanzable desde el servidor de Next
API_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Marle Fashion

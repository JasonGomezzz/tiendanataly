# =====================================================================
# Marle Fashion — PRODUCCIÓN (copiar a .env.prod en el servidor; NUNCA subirlo a git)
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# =====================================================================

# --- Dominio ----------------------------------------------------------
# Dominio público sin https://. Caddy obtiene el certificado automáticamente.
SITE_ADDRESS=tu-dominio.pe
NEXT_PUBLIC_SITE_URL=https://tu-dominio.pe
NEXT_PUBLIC_STORE_NAME=Marle Fashion
HTTP_PORT=80
HTTPS_PORT=443

# --- Django -----------------------------------------------------------
DJANGO_ENV=prod
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=GENERA-UNA-CLAVE-LARGA
DJANGO_DEBUG=false
# "backend" lo usa la tienda (Next) para hablar con la API por dentro; "localhost" el healthcheck.
DJANGO_ALLOWED_HOSTS=tu-dominio.pe,backend,localhost
CSRF_TRUSTED_ORIGINS=https://tu-dominio.pe
CORS_ALLOWED_ORIGINS=https://tu-dominio.pe
# Ruta SECRETA del admin de Django (sin "/" inicial, con "/" final). No uses "admin".
ADMIN_URL_PATH=cambia-esto-por-algo-largo-y-aleatorio/
ADMIN_REQUIRE_2FA=true

# --- Base de datos / cache ---------------------------------------------
POSTGRES_DB=marle
POSTGRES_USER=marle
POSTGRES_PASSWORD=GENERA-UNA-CLAVE-DE-DB
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# --- HTTPS -------------------------------------------------------------
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# --- Tienda ------------------------------------------------------------
STORE_NAME=Marle Fashion
STORE_WHATSAPP=51999999999

# --- Pagos -------------------------------------------------------------
# Lanzamiento: manual_yape_plin. Cuando Culqi esté aprobado y verificado en sandbox: culqi
PAYMENTS_PROVIDER=manual_yape_plin
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_API_BASE=https://api.culqi.com/v2
CULQI_WEBHOOK_SECRET=
CULQI_WEBHOOK_BASIC_USER=
CULQI_WEBHOOK_BASIC_PASSWORD=

# --- Integraciones -------------------------------------------------------
FRONTEND_URL=http://frontend:3000
REVALIDATE_SECRET=GENERA-OTRO-SECRETO
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Correo (recuperar contraseña) ------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Marle Fashion <no-responder@tu-dominio.pe>

# --- Respaldos ------------------------------------------------------------
BACKUP_KEEP_DAYS=14

# =====================================================================
# Credenciales de la copia externa de respaldos (copiar a .env.offsite en el servidor; NUNCA subirlo a git)
# Se usa junto con BACKUP_OFFSITE=offsite:marle-respaldos en .env.prod. Detalle en docs/respaldos.md.
# rclone lee su configuración de variables RCLONE_CONFIG_<NOMBRE>_<OPCION>.
# =====================================================================

# 1) El almacenamiento remoto (ejemplo: Backblaze B2; sirve igual Cloudflare R2, S3 o Google Drive).
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=TU-KEY-ID
RCLONE_CONFIG_B2_KEY=TU-APPLICATION-KEY

# 2) Una capa de cifrado encima: los respaldos tienen datos personales de las clientas (Ley 29733)
#    y salen del servidor, así que viajan y se guardan cifrados (también los nombres de archivo).
RCLONE_CONFIG_OFFSITE_TYPE=crypt
RCLONE_CONFIG_OFFSITE_REMOTE=b2:NOMBRE-DEL-BUCKET/marle
# Clave cifrada: docker run --rm rclone/rclone obscure 'UNA-FRASE-LARGA'
# GUARDA la frase en un lugar seguro y distinto al servidor: sin ella no se pueden restaurar los respaldos.
RCLONE_CONFIG_OFFSITE_PASSWORD=SALIDA-DE-RCLONE-OBSCURE
